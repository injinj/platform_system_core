# Ensure base paths exist with correct labels before the daemon starts.
on post-fs-data
    mkdir /data/aohp 0770 root system
    mkdir /data/aohp/envs 0770 root system
    mkdir /data/aohp/shared 0770 root system
    mkdir /data/aohp/shared/npm-cache 0770 root system
    mkdir /data/aohp/shared/openclaw-dev 0770 root system
    mkdir /data/aohp/shared/uda 0770 root system
    restorecon_recursive /data/aohp

# Mountpoint for the per-container POSIX shm tmpfs. Android has no /dev/shm; the container binds the host
# /dev, so the directory must exist on the host side for containerd to mount a private tmpfs over it
# (wlroots/phoc, squeekboard, zink, Chromium, JVMs all shm_open).
on post-fs
    mkdir /dev/shm 01777 root root

service aohp-containerd /system/bin/aohp-containerd
    class main
    user root
    # readproc: hidepid=invisible on the host /proc hides other users' pids from anyone not
    # in this group; container processes inherit it so ps/pidof see host pids.
    group root system sdcard_rw media_rw everybody readproc
    # CHOWN/FSETID: package managers chown files (dpkg-statoverride, useradd); NET_ADMIN/NET_RAW:
    # container-side networking (WireGuard/VPN, routes, firewall marks). AUDIT_WRITE: libaudit
    # users (sshd pty sessions, PAM, sudo) send AUDIT_USER_* records and get EPERM without it
    # (sepolicy grants the matching self:capability audit_write + netlink_audit_socket).
    capabilities SYS_CHROOT SYS_ADMIN SYS_PTRACE SETUID SETGID DAC_OVERRIDE KILL FOWNER CHOWN FSETID NET_ADMIN NET_RAW AUDIT_WRITE
    socket aohp_container stream 0660 system system
    seclabel u:r:aohp_container_daemon:s0
    writepid /dev/cpuset/system-background/tasks
